# Robot descriptions go to Git LFS. Only USD is listed: it is the only binary
# asset this repository tracks. Training outputs (checkpoints, videos, logs)
# are gitignored, not LFS-tracked.
*.usd filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.usdz filter=lfs diff=lfs merge=lfs -text
